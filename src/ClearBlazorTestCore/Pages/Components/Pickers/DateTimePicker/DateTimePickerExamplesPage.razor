@page "/DateTimePicker"
@using ClearBlazorTest
@inherits ClearComponentBase

<CascadingValue Value="this" IsFixed="false">
    <DocsExamplesPage DocsInfo=@(new DateTimePickerDocsInfo())>
        <TextBlock FontSize="50px" FontWeight=@((int)FontWeight.Normal) Margin="20">Date Time Picker</TextBlock>
        <StackPanel Padding="5" Spacing="30">
            <CodeSnippet Title="Basic" Description="This is an example of basic usage" Code=@(typeof(DateTimePickerSimpleExample).Name)>
                <StackPanel Margin="5" Spacing="20" Orientation=Orientation.Portrait>
                    <DateTimePickerSimpleExample />
                </StackPanel>
            </CodeSnippet>
        </StackPanel>
    </DocsExamplesPage>
</CascadingValue>
