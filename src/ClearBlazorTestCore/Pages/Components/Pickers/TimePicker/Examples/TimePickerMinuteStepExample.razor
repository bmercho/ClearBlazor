@using System.ComponentModel.DataAnnotations
@using System.Globalization
@namespace ClearBlazorTest
@inherits ClearComponentBase

<CascadingValue Value="this" IsFixed="false">
    <TimePicker Margin="0,0,10,0" BorderThickness=1 CornerRadius=4 @bind-Time=Time1 MinuteStep=MinuteStep.Five @bind-Time:after=TimeChanged />
    <TextBlock>@Time1</TextBlock>

    <TimePicker Margin="0,0,10,0" BorderThickness=1 CornerRadius=4 @bind-Time=Time2 MinuteStep=MinuteStep.Fifteen @bind-Time:after=TimeChanged />
    <TextBlock>@Time2</TextBlock>
</CascadingValue>


@code {
    TimeOnly? Time1 { get; set; } = new TimeOnly(22, 45, 0);
    TimeOnly? Time2 { get; set; } = new TimeOnly(08, 15, 0);

    private async Task TimeChanged()
    {
        await Refresh();
    }

}