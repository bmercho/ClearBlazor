@using System.ComponentModel.DataAnnotations
@using System.Globalization
@namespace ClearBlazorTest
@inherits ClearComponentBase

<CascadingValue Value="this" IsFixed="false">
    <TimePicker Margin="0,0,10,0" BorderThickness=1 CornerRadius=4 @bind-Time=Time1 @bind-Time:after=TimeChanged />
    <TextBlock>@Time1</TextBlock>

    <TimePicker Margin="0,0,10,0" BorderThickness=1 CornerRadius=4 Orientation=Orientation.Landscape @bind-Time=Time2
                @bind-Time:after=TimeChanged />
    <TextBlock>@Time2</TextBlock>
</CascadingValue>

@code {
    TimeOnly? Time1 { get; set; } = new TimeOnly(22, 45, 0);
    TimeOnly? Time2 { get; set; } = new TimeOnly(0, 23, 0);

    private async Task TimeChanged()
    {
        StateHasChanged();
    }
}