@using System.ComponentModel.DataAnnotations
@using System.Globalization
@namespace ClearBlazorTest
@inherits ClearComponentBase

<CascadingValue Value="this" IsFixed="false">
    <TimePicker Margin="0,0,10,0" BorderThickness=1 CornerRadius=4 Hours24=true @bind-Time=Time1 @bind-Time:after=TimeChanged />
    <TextBlock>@Time1</TextBlock>
</CascadingValue>

@code {
    TimeOnly? Time1 { get; set; } = new TimeOnly(22, 45, 0);

    private async Task TimeChanged()
    {
        StateHasChanged();
    }

}