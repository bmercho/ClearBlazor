@using System.ComponentModel.DataAnnotations
@using System.Globalization
@namespace ClearBlazorTest
@inherits ClearComponentBase

<CascadingValue Value="this" IsFixed="false">
    <TimePicker Margin="0,0,10,0" BorderThickness=1 CornerRadius=4 @bind-Time=Time
                DefaultTime=@DefaultTime
                @bind-Time:after=TimeChanged />
    <TextBlock>@Time</TextBlock>
</CascadingValue>

@code {
    TimeOnly? Time { get; set; } = null;
    TimeOnly DefaultTime = new TimeOnly(9, 15, 0);

    private async Task TimeChanged()
    {
       await Refresh();
    }
}