@namespace ClearBlazorTest

<Dialog>
    <StackPanel Orientation=@Orientation.Portrait BorderThickness="1" CornerRadius="4" BackgroundColor=Color.Surface>
        <TextBlock Margin="20">Dialog content can contain anything</TextBlock>
        <Button Margin=20 @onclick=@CloseDialog HorizontalAlignment=Alignment.Center>Close</Button>
    </StackPanel>
</Dialog>

@code {

    private async Task CloseDialog()
    {
        await ClearComponentBase.HideDialog();
    }
}
