@namespace ClearBlazorTest
@inherits ClearComponentBase

<CascadingValue Value="this" IsFixed="false">
    <Slider Label="Success" Color=Color.Success @bind-Value=Value />
    <Slider Label="Error" Color=Color.Error @bind-Value=Value />
    <div>@Value</div>
</CascadingValue>
@code {
    public double Value { get; set; } = 50;
}