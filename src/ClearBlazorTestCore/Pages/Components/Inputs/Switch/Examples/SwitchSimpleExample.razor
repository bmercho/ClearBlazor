@namespace ClearBlazorTest
@inherits ClearComponentBase

<CascadingValue Value="this" IsFixed="false">
    <Switch @bind-Checked=BoolValue1 />
    <Switch @bind-Checked=BoolValue2 Color=@Color.Success UncheckedColor=@Color.Error />
</CascadingValue>

@code {
    public bool BoolValue1 { get; set; } = false;
    public bool BoolValue2 { get; set; } = false;
}