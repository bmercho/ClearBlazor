@namespace ClearBlazorTest
@inherits ClearComponentBase

<CascadingValue Value="this" IsFixed="false">
    <TextInput Placeholder="Disabled" InputContainerStyle="InputContainerStyle.LabelOnly" @bind-Value="TextValue" IsDisabled="true" />
    <TextInput Placeholder="Disabled" InputContainerStyle="InputContainerStyle.Underlined" @bind-Value="TextValue" IsDisabled="true" />
    <TextInput Placeholder="Disabled" InputContainerStyle="InputContainerStyle.Outlined" @bind-Value="TextValue" IsDisabled="true" />
    <TextInput Placeholder="Disabled" InputContainerStyle="InputContainerStyle.Filled" @bind-Value="TextValue" IsDisabled="true" />
</CascadingValue>

@code {
    public string TextValue { get; set; } = string.Empty;
}