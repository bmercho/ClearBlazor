@namespace ClearBlazorTest
@inherits ClearComponentBase

<CascadingValue Value="this" IsFixed="false">
    <TextInput Placeholder="Read Only" InputContainerStyle="InputContainerStyle.LabelOnly" @bind-Value="TextValue" IsReadOnly="true" />
    <TextInput Placeholder="Read Only" InputContainerStyle="InputContainerStyle.Underlined" @bind-Value="TextValue" IsReadOnly="true" />
    <TextInput Placeholder="Read Only" InputContainerStyle="InputContainerStyle.Outlined" @bind-Value="TextValue" IsReadOnly="true" />
    <TextInput Placeholder="Read Only" InputContainerStyle="InputContainerStyle.Filled" @bind-Value="TextValue" IsReadOnly="true" />
</CascadingValue>

@code {
    public string TextValue { get; set; } = "Can not change";
}