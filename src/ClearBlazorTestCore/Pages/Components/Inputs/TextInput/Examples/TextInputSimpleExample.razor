@using System.ComponentModel.DataAnnotations

@namespace ClearBlazorTest
@inherits ClearComponentBase

<CascadingValue Value="this" IsFixed="false">
    <TextInput Placeholder="Underlined" InputContainerStyle="InputContainerStyle.Underlined" @bind-Value="TextValue" />
    <TextInput Placeholder="Outlined" InputContainerStyle="InputContainerStyle.Outlined" @bind-Value="TextValue" />
    <TextInput Placeholder="Filled" InputContainerStyle="InputContainerStyle.Filled" @bind-Value="TextValue" />
</CascadingValue>

@code {
    public string TextValue { get; set; } = "Testing 1 2 3";
}