@namespace ClearBlazorTest
@inherits ClearComponentBase

<CascadingValue Value="this" IsFixed="false">
    <CheckBox @bind-Checked=BoolValue1 Label="Primary" />
    <CheckBox @bind-Checked=BoolValue2 Color=@Color.Error Label="Error" LabelLocation=@LabelLocation.Start />
</CascadingValue>

@code {
    public bool BoolValue1 { get; set; } = true;
    public bool BoolValue2 { get; set; } = false;
}