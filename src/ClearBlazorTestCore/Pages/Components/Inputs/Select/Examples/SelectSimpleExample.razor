@namespace ClearBlazorTest
@inherits ClearComponentBase

<CascadingValue Value="this" IsFixed="false">
    <Select Label="Simple" @bind-Value=EnumValue>
        <SelectItem Value=TestEnum.Enum1 Text="A very long message 123456789" />
        <SelectItem Value=TestEnum.Enum2 />
        <SelectItem Value=TestEnum.Enum3 />
        <SelectItem Value=TestEnum.Enum4 />
   </Select>
</CascadingValue>
@code {
    public enum TestEnum
    {
        Enum1, Enum2, Enum3, Enum4
    }

    public TestEnum EnumValue { get; set; } = TestEnum.Enum2;

}