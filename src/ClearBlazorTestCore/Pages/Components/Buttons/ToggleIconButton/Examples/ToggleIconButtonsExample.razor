@namespace ClearBlazorTest
@inherits ClearComponentBase

<CascadingValue Value="this" IsFixed="false">
    <ToggleIconButton Icon=@Icons.Material.Filled.AlarmOff ToggledIcon=@Icons.Material.Filled.AlarmOn
                      Text="Alarm is off" ToggledText="Alarm is on"
                      IconColor=@Color.Error ToggledIconColor=@Color.Success OnToggleChanged=@OnToggleChanged />

    <ToggleIconButton Icon=@Icons.Material.Filled.AlarmOff ToggledIcon=@Icons.Material.Filled.AlarmOn
                      Text="Alarm is off" ToggledText="Alarm is on" Size=Size.VerySmall
                      IconColor=@Color.Error ToggledIconColor=@Color.Success OnToggleChanged=@OnToggleChanged />
</CascadingValue>

@code {
    private void OnToggleChanged(bool toggled)
    {
    }
}