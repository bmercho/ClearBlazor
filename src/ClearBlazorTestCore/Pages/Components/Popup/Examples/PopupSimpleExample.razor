@namespace ClearBlazorTest
@using System.Diagnostics
@inherits ClearComponentBase

<CascadingValue Value="this" IsFixed="false">
    <Grid @ref="Grid" Width="200" Height="200" BorderThickness="1">
        <Button @onclick=@OpenPopup HorizontalAlignment=Alignment.Center VerticalAlignment=Alignment.Center>Open</Button>
    </Grid>
</CascadingValue>

@code {
    Grid Grid = null!;

    private async Task OpenPopup()
    {
        Debug.WriteLine("Open");
        await ShowPopup(typeof(PopupSimple), Grid);
    }
}
