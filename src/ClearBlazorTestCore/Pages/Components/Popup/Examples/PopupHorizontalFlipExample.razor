@namespace ClearBlazorTest
@inherits ClearComponentBase

<CascadingValue Value="this" IsFixed="false">
    <Grid @ref="Grid" Width="200" Height="200" BorderThickness="1" Margin="0,0,0,100">
        <Button @onclick=@OpenPopup HorizontalAlignment=Alignment.Center VerticalAlignment=Alignment.Center>Open</Button>
    </Grid>
</CascadingValue>

@code {
    Grid Grid = null!;
    private bool Open = false;

    private async Task OpenPopup()
    {
        await ShowPopup(typeof(PopupHorizontalFlip), Grid);
    }
}
