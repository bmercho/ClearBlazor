@namespace ClearBlazor
@inherits ClearComponentBase

<Popup CloseOnOutsideClick=@IsMouseNotOver() Margin="1,-20,-20,0"
       Position=Position Transform=Transform
       AllowVerticalFlip=AllowVerticalFlip AllowHorizontalFlip=AllowHorizontalFlip
       @onmouseenter=OnMouseEnter @onmouseleave=OnMouseLeave>
    <TimePicker @ref="TimePicker" ShowSeconds=@ShowSeconds Hours24=@Hours24 MinuteStep=@MinuteStep Orientation=@Orientation
                BorderThickness=1 CornerRadius=4 @bind-Time=TimeOnly @bind-Time:after=TimeChanged
                MinuteSelected=@TimeSelection SecondSelected=@TimeSelection DefaultTime=@DefaultTime />
</Popup>

